# AJG SOP Web Application - Production Environment Configuration
# Set these variables in Vercel project settings (Environment Variables)

# App mode: 'live' for production, 'fixture' for local development without backend dependencies
VITE_APP_MODE=live

# Railway API backend URL (must NOT end with trailing slash)
# Example: https://api-ajg-sop-production.up.railway.app/api/v1
VITE_API_URL=https://<your-railway-app>.up.railway.app/api/v1

# Auth0 tenant domain for authentication
# Example: ajt-sop.us.auth0.com
VITE_AUTH0_DOMAIN=<your-auth0-domain>.auth0.com

# Auth0 Single Page App Client ID
VITE_AUTH0_CLIENT_ID=<your-auth0-client-id>

# Auth0 API Audience identifier (must match backend AUTH0_AUDIENCE)
# Example: https://api.ajt-sop.internal
VITE_AUTH0_AUDIENCE=https://api.ajt-sop.internal
