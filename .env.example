APP_MODE=fixture
APP_ENV=development
APP_NAME=Aziz Jan Group SOP Knowledge System
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aziz_jan_sop
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aziz-jan-sop-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PINECONE_API_KEY=
PINECONE_INDEX=aziz-jan-sop
PINECONE_NAMESPACE_PREFIX=aziz-jan-trust

FIREBASE_PROJECT_ID=ajg-sop-web
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local fixtures are explicit. Live deployments must select openrouter or deepseek.
LLM_PROVIDER=fixture
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_TEMPERATURE=0.2
# Optional JSON array of approved provider slugs. Privacy constraints always apply.
OPENROUTER_ALLOWED_PROVIDERS=[]
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_READ_TIMEOUT_SECONDS=20
LLM_MAX_CONNECTIONS=20
# Explicit rollback provider credentials remain supported.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

EMBEDDING_PROVIDER=fixture
EMBEDDING_MODEL=multilingual-e5-large
RERANKER_PROVIDER=fixture
DOCUMENT_PARSER_PROVIDER=fixture
SPEECH_PROVIDER=disabled
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

VITE_APP_MODE=fixture
VITE_API_URL=http://localhost:8000/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ajg-sop-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ajg-sop-web
VITE_FIREBASE_APP_ID=
VITE_VOICE_INPUT_ENABLED=false
